TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=8080
DATA_DIR=/var/data
LOG_LEVEL=INFO
SYMBOL=BTC

# PAPER account
PAPER_START_BALANCE=500
MIN_FREE_CASH=5

# M03 / V2 base eligibility
DECISION_INTERVAL=3.0
TRADE_WINDOW_SECONDS=180
ENTRY_MOVE=0.03
PYRAMID_STEP=0.08
LOOKBACK_TICKS=2
V2_ELIGIBLE_PRICE_MIN=0.55
V2_ELIGIBLE_PRICE_MAX=0.75
V2_ELIGIBLE_MOM_MIN=0.03
V2_ELIGIBLE_MOM_MAX=0.30

# SAFE first-signal gate
SAFE_ENTRY_PRICE_MIN=0.64
SAFE_ENTRY_PRICE_MAX=0.75
SAFE_ENTRY_MOM_MIN=0.05
SAFE_ENTRY_MOM_MAX=0.10

# Position sizing
ENTRY_ORDER_SIZE=5
PYRAMID_ORDER_SIZE=10
PYRAMID_MOMENTUM_CAP=0.30
MAX_BUYS_SIDE=2

# Market / fee
MIN_PRICE=0.08
MAX_PRICE=0.95
CRYPTO_FEE_RATE=0.07
DISCOVERY_INTERVAL=10
MAX_BOOK_AGE_MS=1000

# Hourly report
REPORT_DELAY_SECONDS=300
REPORT_CHECK_INTERVAL=30

# Render stability
MEMORY_CLEANUP_INTERVAL=60
MEMORY_KEEP_RESOLVED_SEC=900
WS_MAX_CONNECTION_AGE_SEC=900
MEMORY_LOG_INTERVAL=300
