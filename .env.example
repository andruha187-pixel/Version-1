# PAPER ONLY. No wallet or private key is used anywhere.

# Three independent strategies:
THRESHOLDS=0.79,0.84,0.89
TRADE_NOTIONAL_USD=5
START_BALANCE_USD=1000

# Telegram (optional but recommended)
# IMPORTANT: do not run two polling services with the same bot token at the same time.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Render persistent disk
DB_PATH=/var/data/weather_paper_v2.db
REPORT_DIR=/var/data/reports_v2

# Data refresh
DISCOVERY_INTERVAL_SECONDS=300
RESOLUTION_INTERVAL_SECONDS=60
PRICE_SNAPSHOT_INTERVAL_SECONDS=30
EQUITY_SNAPSHOT_INTERVAL_SECONDS=60
HOURLY_REPORTS=true

# Risk / controls
STOP_LOSS_ENABLED=true
STOP_LOSS_PRICE=0.40
STOP_LOSS_SCAN_INTERVAL_SECONDS=5
# Used only if no saved Start/Stop state exists yet.
TRADING_ENABLED_ON_START=true

# Entry liquidity filter. The full $5 must exist close to the best ask;
# far-away asks are deliberately ignored so a thin book cannot create a fake good fill.
ENTRY_LIQUIDITY_CHECK_ENABLED=true
MIN_ENTRY_LIQUIDITY_USD=5
MAX_ENTRY_SLIPPAGE=0.02
REQUIRE_FULL_FILL=true
MIN_FULL_FILL_RATIO=0.999

# Current Weather taker fee fallback if per-market fee lookup is temporarily unavailable.
WEATHER_FEE_RATE_FALLBACK=0.05

# Polymarket site tags used for discovery; title/slug is additionally filtered.
DISCOVERY_TAG_SLUGS=temperature,weather

# Optional protection for the web dashboard. If set, open /?token=VALUE
DASHBOARD_TOKEN=

PORT=8080
LOG_LEVEL=INFO
